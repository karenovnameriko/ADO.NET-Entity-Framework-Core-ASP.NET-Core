@page
@model KT2_Textarea.Pages.Task3

@{
    ViewData["Title"] = "Задание 3";
}

<h1>WYSIWYG редактор</h1>

<form method="post">
    <textarea id="editor" name="text">@Html.Raw(Model.Text)</textarea>

    <br />

    <button type="submit">Сохранить</button>
</form>

<script src="https://cdn.tiny.cloud/1/tujv09qnzb247xku9uci5xevu3n8yvstlum9fg00ya5w9aqh/tinymce/5/tinymce.min.js"
        referrerpolicy="origin">
</script>

<script>
    tinymce.init({
        selector: '#editor'
    });
</script>