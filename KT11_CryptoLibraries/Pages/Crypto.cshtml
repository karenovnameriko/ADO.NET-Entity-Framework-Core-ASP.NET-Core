@page
@model KT11_CryptoLibraries.Pages.CryptoModel

@{
    ViewData["Title"] = "Библиотеки шифрования";
}

<div class="container mt-4">

    <h1 class="mb-4">Библиотеки шифрования</h1>

    <p class="text-muted">
        Шифрование и дешифрование пользовательского текста
        с использованием Bouncy Castle и Libsodium.
    </p>

    <hr />

    <!-- BOUNCY CASTLE -->

    <section class="card p-4 mb-4">

        <h2>Bouncy Castle — AES-256-GCM</h2>

        <p>
            Шифрование и дешифрование текста с помощью
            библиотеки Bouncy Castle.
        </p>

        <form method="post" asp-page-handler="BouncyEncrypt">

            <div class="mb-3">
                <label class="form-label">Исходный текст</label>

                <textarea asp-for="BouncyPlainText"
                          class="form-control"
                          rows="3"
                          placeholder="Введите текст для шифрования"></textarea>
            </div>

            <button type="submit" class="btn btn-primary">
                Зашифровать
            </button>

        </form>

        @if (!string.IsNullOrEmpty(Model.BouncyEncryptedText))
        {
            <div class="mt-3">
                <label class="form-label">
                    Зашифрованный текст (Base64)
                </label>

                <textarea class="form-control"
                          rows="4"
                          readonly>@Model.BouncyEncryptedText</textarea>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.BouncyMessage))
        {
            <div class="alert alert-success mt-3">
                @Model.BouncyMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.BouncyError))
        {
            <div class="alert alert-danger mt-3">
                @Model.BouncyError
            </div>
        }

        <hr />

        <h4>Дешифрование</h4>

        <form method="post" asp-page-handler="BouncyDecrypt">

            <div class="mb-3">
                <label class="form-label">
                    Зашифрованный текст
                </label>

                <textarea asp-for="BouncyCipherText"
                          class="form-control"
                          rows="4"
                          placeholder="Вставьте зашифрованный текст"></textarea>
            </div>

            <button type="submit" class="btn btn-success">
                Расшифровать
            </button>

        </form>

        @if (!string.IsNullOrEmpty(Model.BouncyDecryptedText))
        {
            <div class="alert alert-info mt-3">
                <strong>Расшифрованный текст:</strong>
                <p class="mb-0">@Model.BouncyDecryptedText</p>
            </div>
        }

    </section>


    <!-- LIBSODIUM -->

    <section class="card p-4 mb-4">

        <h2>Libsodium — SecretBox</h2>

        <p>
            Шифрование и дешифрование текста с использованием
            библиотеки Libsodium и алгоритма SecretBox.
        </p>

        <form method="post" asp-page-handler="SodiumEncrypt">

            <div class="mb-3">
                <label class="form-label">Исходный текст</label>

                <textarea asp-for="SodiumPlainText"
                          class="form-control"
                          rows="3"
                          placeholder="Введите текст для шифрования"></textarea>
            </div>

            <button type="submit" class="btn btn-primary">
                Зашифровать
            </button>

        </form>

        @if (!string.IsNullOrEmpty(Model.SodiumEncryptedText))
        {
            <div class="mt-3">
                <label class="form-label">
                    Зашифрованный текст (Base64)
                </label>

                <textarea class="form-control"
                          rows="4"
                          readonly>@Model.SodiumEncryptedText</textarea>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.SodiumMessage))
        {
            <div class="alert alert-success mt-3">
                @Model.SodiumMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.SodiumError))
        {
            <div class="alert alert-danger mt-3">
                @Model.SodiumError
            </div>
        }

        <hr />

        <h4>Дешифрование</h4>

        <form method="post" asp-page-handler="SodiumDecrypt">

            <div class="mb-3">
                <label class="form-label">
                    Зашифрованный текст
                </label>

                <textarea asp-for="SodiumCipherText"
                          class="form-control"
                          rows="4"
                          placeholder="Вставьте зашифрованный текст"></textarea>
            </div>

            <button type="submit" class="btn btn-success">
                Расшифровать
            </button>

        </form>

        @if (!string.IsNullOrEmpty(Model.SodiumDecryptedText))
        {
            <div class="alert alert-info mt-3">
                <strong>Расшифрованный текст:</strong>
                <p class="mb-0">@Model.SodiumDecryptedText</p>
            </div>
        }

    </section>

</div>