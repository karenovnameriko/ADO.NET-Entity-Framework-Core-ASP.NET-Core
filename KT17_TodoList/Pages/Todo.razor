
@page "/todo"

<PageTitle>Список задач</PageTitle>

<div class="container mt-4">
    <h1>Список задач</h1>
    <p class="text-muted">Планируй дела и отслеживай их выполнение.</p>

    <div class="card p-3 mb-4">
        <h5>@(_editingId == null ? "Новая задача" : "Редактирование задачи")</h5>

        <div class="mb-3">
            <label class="form-label">Название задачи</label>
            <input class="form-control"
                   @bind="_title"
                   placeholder="Например, подготовить отчёт" />
        </div>

        <div class="mb-3">
            <label class="form-label">Описание</label>
            <textarea class="form-control"
                      @bind="_description"
                      rows="2"
                      placeholder="Дополнительная информация"></textarea>
        </div>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-danger">@_error</div>
        }

        <div>
            <button class="btn btn-primary me-2" @onclick="SaveTask">
                @(_editingId == null ? "Добавить" : "Сохранить")
            </button>

            @if (_editingId != null)
            {
                <button class="btn btn-secondary" @onclick="CancelEdit">
                    Отмена
                </button>
            }
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2 mb-3">
        <button class="@FilterClass("all")" @onclick='() => SetFilter("all")'>
            Все (@_tasks.Count)
        </button>

        <button class="@FilterClass("active")" @onclick='() => SetFilter("active")'>
            Активные (@_tasks.Count(t => !t.IsCompleted))
        </button>

        <button class="@FilterClass("completed")" @onclick='() => SetFilter("completed")'>
            Выполненные (@_tasks.Count(t => t.IsCompleted))
        </button>
    </div>

    @if (!FilteredTasks.Any())
    {
        <div class="alert alert-info">
            Задач пока нет.
        </div>
    }
    else
    {
        @foreach (var task in FilteredTasks)
        {
            <div class="card mb-2">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                        <div>
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       checked="@task.IsCompleted"
                                       @onchange="() => ToggleTask(task.Id)" />

                                <label class="form-check-label">
                                    <strong class="@(task.IsCompleted ? "text-decoration-line-through text-muted" : "")">
                                        @task.Title
                                    </strong>
                                </label>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(task.Description))
                            {
                                <p class="text-muted mt-2 mb-0">@task.Description</p>
                            }

                            <small class="text-muted">
                                @(task.IsCompleted ? "Выполнена" : "В работе")
                            </small>
                        </div>

                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-primary"
                                    @onclick="() => EditTask(task)">
                                Изменить
                            </button>

                            <button class="btn btn-sm btn-outline-danger"
                                    @onclick="() => DeleteTask(task.Id)">
                                Удалить
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    private readonly List<TodoTask> _tasks = new();
    private int _nextId = 1;

    private string _title = string.Empty;
    private string _description = string.Empty;
    private string _error = string.Empty;
    private string _filter = "all";
    private int? _editingId;

    private IEnumerable<TodoTask> FilteredTasks => _filter switch
    {
        "active" => _tasks.Where(t => !t.IsCompleted),
        "completed" => _tasks.Where(t => t.IsCompleted),
        _ => _tasks
    };

    private void SaveTask()
    {
        _error = string.Empty;

        if (string.IsNullOrWhiteSpace(_title))
        {
            _error = "Введите название задачи.";
            return;
        }

        if (_editingId == null)
        {
            _tasks.Add(new TodoTask
            {
                Id = _nextId++,
                Title = _title.Trim(),
                Description = _description.Trim()
            });
        }
        else
        {
            var task = _tasks.FirstOrDefault(t => t.Id == _editingId);

            if (task != null)
            {
                task.Title = _title.Trim();
                task.Description = _description.Trim();
            }
        }

        ClearForm();
    }

    private void EditTask(TodoTask task)
    {
        _editingId = task.Id;
        _title = task.Title;
        _description = task.Description;
        _error = string.Empty;
    }

    private void DeleteTask(int id)
    {
        _tasks.RemoveAll(t => t.Id == id);

        if (_editingId == id)
        {
            ClearForm();
        }
    }

    private void ToggleTask(int id)
    {
        var task = _tasks.FirstOrDefault(t => t.Id == id);

        if (task != null)
        {
            task.IsCompleted = !task.IsCompleted;
        }
    }

    private void SetFilter(string filter)
    {
        _filter = filter;
    }

    private string FilterClass(string filter)
    {
        return _filter == filter
            ? "btn btn-primary"
            : "btn btn-outline-primary";
    }

    private void CancelEdit()
    {
        ClearForm();
    }

    private void ClearForm()
    {
        _title = string.Empty;
        _description = string.Empty;
        _editingId = null;
        _error = string.Empty;
    }

    private sealed class TodoTask
    {
        public int Id { get; set; }
        public string Title { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public bool IsCompleted { get; set; }
    }
}
