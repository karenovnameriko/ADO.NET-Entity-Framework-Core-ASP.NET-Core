@page
@model IndexModel

@{
    ViewData["Title"] = "Учебная система";
}

<div class="container mt-5">
    <h1>Система управления учебным процессом</h1>

    <p class="text-muted">
        Управление преподавателями, студентами и курсами.
    </p>

    <div class="d-flex flex-wrap gap-2 mt-4">
        <a asp-page="/Teachers/Index" class="btn btn-primary btn-lg">
            Преподаватели
        </a>

        <a asp-page="/Students/Index" class="btn btn-success btn-lg">
            Студенты
        </a>

        <a asp-page="/Courses/Index" class="btn btn-info btn-lg">
            Курсы
        </a>
    </div>
</div>