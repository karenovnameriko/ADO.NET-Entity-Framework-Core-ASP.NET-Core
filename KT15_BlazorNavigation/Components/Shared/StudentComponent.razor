@implements IDisposable

@inject LocalizationService Localization

<div class="card p-3 mb-4" style="max-width: 450px;">

    <h3>@Localization.Text("studentInfo")</h3>

    <p><strong>Name:</strong> @Name</p>

    <p>
        <strong>@Localization.Text("age"):</strong>
        @_currentAge
    </p>

    <div class="d-flex gap-2">

        <button class="btn btn-primary"
                @onclick="IncreaseAge">
            @Localization.Text("increase")
        </button>

        <button class="btn btn-secondary"
                @onclick="ResetAge">
            @Localization.Text("reset")
        </button>

    </div>

</div>

@code {
    [Parameter]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public int Age { get; set; }

    private int _currentAge;
    private int _initialAge;

    protected override void OnInitialized()
    {
        _initialAge = Age;
        _currentAge = Age;

        Localization.LanguageChanged += OnLanguageChanged;
    }

    private void IncreaseAge()
    {
        _currentAge++;
    }

    private void ResetAge()
    {
        _currentAge = _initialAge;
    }

    private void OnLanguageChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Localization.LanguageChanged -= OnLanguageChanged;
    }
}