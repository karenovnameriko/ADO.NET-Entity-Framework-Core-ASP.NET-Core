@page "{id:int}"
@model KT12_OneToOne.Pages.Users.DeleteModel

@{
    ViewData["Title"] = "Удаление пользователя";
}

<div class="container mt-4">
    <h1>Удаление пользователя</h1>

    <div class="alert alert-warning">
        Вы действительно хотите удалить этого пользователя и его профиль?
    </div>

    <h4>Данные пользователя</h4>

    <p><strong>Имя:</strong> @Model.SelectedUser!.Name</p>
    <p><strong>Email:</strong> @Model.SelectedUser.Email</p>

    <h4>Данные профиля</h4>

    <p><strong>Телефон:</strong> @Model.SelectedUser.Profile.Phone</p>
    <p><strong>Город:</strong> @Model.SelectedUser.Profile.City</p>

    <form method="post">
        <button type="submit" class="btn btn-danger">
            Удалить
        </button>

        <a asp-page="./Index" class="btn btn-secondary">
            Отмена
        </a>
    </form>
</div>