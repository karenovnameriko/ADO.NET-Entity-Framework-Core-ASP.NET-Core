@page
@model KT13_OneToMany.Pages.Books.IndexModel

@{
    ViewData["Title"] = "Книги";
}

<div class="container mt-4">
    <h1>Книги</h1>

    <a asp-page="./Create" class="btn btn-primary mb-3">
        Добавить книгу
    </a>

    <a asp-page="/Authors/Index" class="btn btn-secondary mb-3">
        Авторы
    </a>

    @if (!Model.Books.Any())
    {
        <p>Книг пока нет.</p>
    }
    else
    {
        <table class="table table-bordered table-striped">
            <thead>
            <tr>
                <th>ID</th>
                <th>Название</th>
                <th>Год</th>
                <th>Жанр</th>
                <th>Автор</th>
                <th>Действия</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var book in Model.Books)
            {
                <tr>
                    <td>@book.Id</td>
                    <td>@book.Title</td>
                    <td>@book.Year</td>
                    <td>@book.Genre</td>
                    <td>@book.Author.Name</td>
                    <td>
                        <a asp-page="./Edit"
                           asp-route-id="@book.Id"
                           class="btn btn-warning btn-sm">
                            Изменить
                        </a>

                        <a asp-page="./Delete"
                           asp-route-id="@book.Id"
                           class="btn btn-danger btn-sm">
                            Удалить
                        </a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>