@page "{id:int}"
@model KT13_OneToMany.Pages.Books.DeleteModel

@{
    ViewData["Title"] = "Удаление книги";
}

<div class="container mt-4">
    <h1>Удаление книги</h1>

    <div class="alert alert-warning">
        Вы действительно хотите удалить эту книгу?
    </div>

    <p><strong>Название:</strong> @Model.SelectedBook!.Title</p>
    <p><strong>Год:</strong> @Model.SelectedBook.Year</p>
    <p><strong>Жанр:</strong> @Model.SelectedBook.Genre</p>
    <p><strong>Автор:</strong> @Model.SelectedBook.Author.Name</p>

    <form method="post">
        <button type="submit" class="btn btn-danger">
            Удалить книгу
        </button>

        <a asp-page="./Index" class="btn btn-secondary">
            Отмена
        </a>
    </form>
</div>