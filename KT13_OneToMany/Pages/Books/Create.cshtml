@page
@model KT13_OneToMany.Pages.Books.CreateModel

@{
    ViewData["Title"] = "Добавление книги";
}

<div class="container mt-4">
    <h1>Добавление книги</h1>

    @if (!Model.AuthorOptions.Any())
    {
        <div class="alert alert-warning">
            Сначала добавьте автора.

            <a asp-page="/Authors/Create">Добавить автора</a>
        </div>
    }
    else
    {
        <form method="post">
            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Input.Title" class="form-label">
                    Название книги
                </label>

                <input asp-for="Input.Title" class="form-control" />

                <span asp-validation-for="Input.Title"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Year" class="form-label">
                    Год издания
                </label>

                <input asp-for="Input.Year"
                       type="number"
                       class="form-control" />

                <span asp-validation-for="Input.Year"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Genre" class="form-label">
                    Жанр
                </label>

                <input asp-for="Input.Genre" class="form-control" />

                <span asp-validation-for="Input.Genre"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.AuthorId" class="form-label">
                    Автор
                </label>

                <select asp-for="Input.AuthorId"
                        asp-items="Model.AuthorOptions"
                        class="form-select">
                    <option value="0">Выберите автора</option>
                </select>

                <span asp-validation-for="Input.AuthorId"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Сохранить
            </button>

            <a asp-page="./Index" class="btn btn-secondary">
                Назад
            </a>
        </form>
    }
</div>