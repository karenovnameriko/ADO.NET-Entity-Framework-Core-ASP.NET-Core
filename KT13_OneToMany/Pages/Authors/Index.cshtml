@page
@model KT13_OneToMany.Pages.Authors.IndexModel

@{
    ViewData["Title"] = "Авторы";
}

<div class="container mt-4">
    <h1>Авторы</h1>

    <a asp-page="./Create" class="btn btn-primary mb-3">
        Добавить автора
    </a>

    <a asp-page="/Books/Index" class="btn btn-secondary mb-3">
        Книги
    </a>

    @if (!Model.Authors.Any())
    {
        <p>Авторов пока нет.</p>
    }
    else
    {
        <table class="table table-bordered table-striped">
            <thead>
            <tr>
                <th>ID</th>
                <th>Имя</th>
                <th>Страна</th>
                <th>Количество книг</th>
                <th>Действия</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var author in Model.Authors)
            {
                <tr>
                    <td>@author.Id</td>
                    <td>@author.Name</td>
                    <td>@author.Country</td>
                    <td>@author.Books.Count</td>
                    <td>
                        <a asp-page="./Edit"
                           asp-route-id="@author.Id"
                           class="btn btn-warning btn-sm">
                            Изменить
                        </a>

                        <a asp-page="./Delete"
                           asp-route-id="@author.Id"
                           class="btn btn-danger btn-sm">
                            Удалить
                        </a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>